{
  "manifest_version": 3,
  "name": "Lồng Tiếng Việt – lồng tiếng YouTube, Udemy, Coursera",
  "short_name": "Lồng Tiếng Việt",
  "version": "1.1.0",
  "description": "Dịch phụ đề – hoặc tự chép lời khi video không có phụ đề – rồi đọc lồng tiếng Việt ngay trên YouTube, Udemy, Coursera.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lồng Tiếng Việt",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tts", "offscreen", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://*.coursera.org/*",
    "https://video.twimg.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "exclude_matches": ["https://www.youtube.com/embed/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://drive.google.com/file/*"
      ],
      "exclude_matches": ["https://www.youtube.com/embed/*"],
      "js": [
        "shared/defaults.js",
        "content/lib/util.js",
        "content/lib/captions-parse.js",
        "content/lib/segment.js",
        "content/lib/timing.js",
        "content/lib/tracks.js",
        "content/lib/bridge.js",
        "content/lib/connection.js",
        "content/lib/speech-client.js",
        "content/lib/translate-queue.js",
        "content/lib/audio-chunker.js",
        "content/lib/phrase-cutter.js",
        "content/lib/overlay.js",
        "content/lib/auto-start.js",
        "content/lib/yt-timedtext.js",
        "content/lib/hls.js",
        "content/lib/drive-timedtext.js",
        "content/lib/drive-channel.js",
        "content/lib/quiz-text.js",
        "content/providers/html5.js",
        "content/providers/youtube.js",
        "content/providers/udemy.js",
        "content/providers/coursera.js",
        "content/providers/drive.js",
        "content/providers/x.js",
        "content/dubber.js",
        "content/asr/chrome-recognizer.js",
        "content/asr/whisper-recognizer.js",
        "content/live-dubber.js",
        "content/live-pipeline.js",
        "content/live-session.js",
        "content/voice-fallback.js",
        "content/sites/drive-host.js",
        "content/badges.js",
        "content/quiz.js",
        "content/addons.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*",
        "https://youtube.googleapis.com/embed/*"
      ],
      "all_frames": true,
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*",
        "https://youtube.googleapis.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "shared/defaults.js",
        "content/lib/util.js",
        "content/lib/captions-parse.js",
        "content/lib/segment.js",
        "content/lib/timing.js",
        "content/lib/tracks.js",
        "content/lib/bridge.js",
        "content/lib/connection.js",
        "content/lib/speech-client.js",
        "content/lib/translate-queue.js",
        "content/lib/audio-chunker.js",
        "content/lib/phrase-cutter.js",
        "content/lib/overlay.js",
        "content/lib/auto-start.js",
        "content/lib/yt-timedtext.js",
        "content/lib/hls.js",
        "content/lib/drive-timedtext.js",
        "content/lib/drive-channel.js",
        "content/lib/quiz-text.js",
        "content/providers/html5.js",
        "content/providers/youtube.js",
        "content/providers/udemy.js",
        "content/providers/coursera.js",
        "content/providers/drive.js",
        "content/providers/x.js",
        "content/dubber.js",
        "content/asr/chrome-recognizer.js",
        "content/asr/whisper-recognizer.js",
        "content/live-dubber.js",
        "content/live-pipeline.js",
        "content/live-session.js",
        "content/voice-fallback.js",
        "content/sites/drive-host.js",
        "content/badges.js",
        "content/quiz.js",
        "content/addons.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dubbing": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Bật/tắt lồng tiếng video đang xem"
    }
  }
}
