{
  "manifest_version": 3,
  "name": "Lồng Tiếng Việt – lồng tiếng YouTube, Udemy, Coursera",
  "short_name": "Lồng Tiếng Việt",
  "version": "1.0.0",
  "description": "Dịch phụ đề và đọc lồng tiếng Việt ngay trên video YouTube, Udemy, Coursera. Giọng Google hoặc giọng máy, dịch bằng Google hoặc Claude.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lồng Tiếng Việt",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tts", "offscreen", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://*.coursera.org/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*"
      ],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/lib/util.js",
        "content/lib/captions-parse.js",
        "content/lib/segment.js",
        "content/lib/timing.js",
        "content/lib/tracks.js",
        "content/lib/bridge.js",
        "content/lib/connection.js",
        "content/lib/speech-client.js",
        "content/lib/translate-queue.js",
        "content/lib/overlay.js",
        "content/providers/html5.js",
        "content/providers/youtube.js",
        "content/providers/udemy.js",
        "content/providers/coursera.js",
        "content/dubber.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dubbing": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Bật/tắt lồng tiếng video đang xem"
    }
  }
}
